name = "sen-qa-web"
main = "src/worker.js"
compatibility_date = "2026-08-11"

[assets]
directory = "./public"
binding = "ASSETS"
run_worker_first = true

[[kv_namespaces]]
binding = "QUESTIONS"
id = "replace-with-questions-kv-id"

[vars]
GITLAB_API_ROOT = "https://gitlab.aigov.go.kr/api/v4"
GITLAB_PROJECT_ID = "428"
PUBLIC_ORIGIN = "https://replace-with-public-hostname"
TURNSTILE_SITE_KEY = "replace-with-turnstile-site-key"

# Configure only through `wrangler secret put`:
# - GITLAB_TOKEN
# - TURNSTILE_SECRET
